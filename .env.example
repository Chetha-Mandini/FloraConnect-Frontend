# Public client setting. Never put passwords, tokens, or database credentials in VITE_* variables.
# Local development: /api is forwarded to API_PROXY_TARGET by Vite.
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://localhost:3001
# Vercel production: keep VITE_API_BASE_URL=/api and configure BACKEND_API_BASE_URL in the frontend server environment.
# BACKEND_API_BASE_URL=https://your-backend.example/api
# Existing Vercel VITE_API_URL settings are accepted as a server-side fallback.
# Its value must be an HTTPS backend origin or API base, never /api or a frontend URL.
# Prefer BACKEND_API_BASE_URL for new deployments. VITE_API_URL is not exposed to browser code.
# API_PROXY_TARGET is only used by the local Vite server/preview and is not included in browser code.
